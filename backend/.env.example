PORT=4000
NODE_ENV=development

# Supabase (server-side only — service role key must NEVER reach the browser)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Comma-separated list of allowed origins for CORS
FRONTEND_URL=http://localhost:3000

# Shared secret required in the header of the cron trigger endpoint,
# so only Render Cron (or your scheduler) can invoke it.
CRON_SECRET=change-me-to-a-long-random-string
